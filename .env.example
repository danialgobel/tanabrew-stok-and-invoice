# Tanabrew Environment Variables Template
# Salin file ini menjadi .env atau .env.local dan isi nilainya sesuai akun proyek Anda.

# Google Firebase Configuration (Web Client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OneSignal Push Notification Configuration
VITE_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Spreadsheet Integrations (Opsional)
VITE_SPREADSHEET_API=
