# Tanabrew Environment Variables Template
# Salin file ini menjadi .env atau .env.local dan isi nilainya sesuai akun proyek Anda.

# Google Firebase Configuration (Web Client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OneSignal Push Notification Configuration
VITE_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Email Dispatcher Configuration (Pilih salah satu atau pasang keduanya)
# Opsi 1: Gmail SMTP Resmi (Nodemailer) - 100% Anti-Spam & Kirim ke SEMUA user tanpa beli domain
GMAIL_USER=danialgobel26@gmail.com
GMAIL_APP_PASSWORD=

# Opsi 2: Resend API (Jika menggunakan domain khusus seperti tanabrew.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Tanabrew System <onboarding@resend.dev>
OWNER_EMAIL=danialgobel26@gmail.com

# Spreadsheet Integrations (Opsional)
VITE_SPREADSHEET_API=

